# Strata Sync Bot — Environment variable settings
# Copy this file to .env and fill in the real values.
# .env is listed in .gitignore, so it is never committed to Git.

ANTHROPIC_API_KEY=sk-ant-api03-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Optional — team server (Cloudflare Worker). With these set, /propose works even when nobody
# has the desktop app open: proposals go straight to the team vault's _agent/ folder.
# STRATA_SERVER_URL=https://strata-sync.<account>.workers.dev
# STRATA_TEAM_TOKEN=...
# STRATA_BOT_AUTHOR=slack-bot
